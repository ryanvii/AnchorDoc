# AnchorDoc LLM runtime configuration (OpenAI-compatible)
ANCHORDOC_LLM_BASE=https://api.openai.com/v1
ANCHORDOC_LLM_MODEL=gpt-4o-mini
ANCHORDOC_LLM_KEY=
# Or load key from a local file outside the repo:
# ANCHORDOC_LLM_KEY_FILE=~/.config/anchordoc/api.key

# Deterministic offline replay (1 = read cache only, error on cache miss)
ANCHORDOC_OFFLINE=0
